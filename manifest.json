{
    "name": "Polyester Block",
    "description": "A way to block using polyester edits",
    "manifest_version": 3,
    "version": "1.0"
    ,
    "action": {
        "default_popup": "src/index.html"
    }
    ,
    "content_scripts": [
    {
      "js": ["src/video_replace.js"],
      "matches": [
        "https://*.com/*"
      ]
    }
  ],
  "permissions": [
    "scripting"
  ]
}