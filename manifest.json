{
    "name": "Polyester Block",
    "description": "A way to block using polyester edits",
    "manifest_version": 3,
    "version": "1.0"
    ,
    "action": {
        "default_popup": "src/index.html"
    }
    ,

    "content_scripts": [
    {
      "js": ["src/video_replace.js"],
      "matches": [
        "https://*.com/*"
      ]
    }
  ],

   "web_accessible_resources": [
    {
      "resources": ["Videos/*.mp4"],
      "matches": ["https://*.com/*"]
    }
  ],

  "permissions": [
    "scripting", "activeTab"
  ],
  
    "icons": {
        "16": "Images/Icon.png",
        "32": "Images/Icon.png",
        "48": "Images/Icon.png",
        "128": "Images/Icon.png"
    }
}